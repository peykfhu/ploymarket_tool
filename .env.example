
# ============================================

# Polymarket 套利系统 - 环境配置

# ============================================



# === 服务端口 ===

BACKEND_PORT=8899

FRONTEND_PORT=3999

WS_PORT=8898



# === Polymarket API ===

# 从 polymarket.com 申请获得的三个值

POLYMARKET_API_KEY=your_api_key_here

POLYMARKET_API_SECRET=your_secret_here

POLYMARKET_PASSPHRASE=your_passphrase_here



# === 钱包配置（Polygon链）===

# MetaMask 钱包地址（0x开头）

POLYMARKET_WALLET_ADDRESS=0xyour_wallet_address

# MetaMask 私钥（用于签名交易，MetaMask→账户详情→导出私钥）

POLYMARKET_PRIVATE_KEY=your_private_key_here



# === NOAA 气象 API（免费）===

# 申请: https://www.weather.gov/documentation/services-web-api

NOAA_API_TOKEN=



# === Binance API ===

BINANCE_API_KEY=

BINANCE_API_SECRET=



# === 新闻 API ===

# 申请: https://newsapi.org (免费100次/天)

NEWSAPI_KEY=



# === 通知（可选）===

TELEGRAM_BOT_TOKEN=

TELEGRAM_CHAT_ID=

DISCORD_WEBHOOK_URL=



# === 风控参数 ===

MAX_POSITION_SIZE=50

MAX_DAILY_LOSS=200

MIN_EDGE_THRESHOLD=0.06

MAX_CONCURRENT_POSITIONS=20

STOP_LOSS_PERCENT=0.15



# === 数据库 ===

DATABASE_URL=sqlite:///./polymarket_bot.db



# === 安全 ===

DASHBOARD_PASSWORD=admin123

JWT_SECRET=change-me-please



# === 交易模式 ===

# true = 模拟交易（不真正下单）

# false = 真实交易

DRY_RUN=true

LOG_LEVEL=INFO

