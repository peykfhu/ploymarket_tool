http://${LOCAL_IP}:${B_PORT}/api/health " echo -e "${GREEN}║${NC} 📡 ${BOLD}WebSocket:${NC} ws://${LOCAL_IP}:${B_PORT}/ws " 
fi echo -e "${GREEN}║ ║${NC}" echo -e "${GREEN}╠═══════════════════════════════════════════════════╣${NC}" echo -e 
