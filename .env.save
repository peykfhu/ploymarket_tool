polymarket-backend${NC}" echo -e "${GREEN}║${NC} ${GREEN}║${NC}" echo -e "${GREEN}║${NC} 重启服务 ${CYAN}cd $INSTALL_DIR && 
$COMPOSE_CMD restart${NC}" echo -e "${GREEN}║${NC} 停止服务 ${CYAN}cd $INSTALL_DIR && $COMPOSE_CMD down${NC}" echo -e 
"${GREEN}║${NC} 编辑配置 ${CYAN}nano $INSTALL_DIR/.env${NC}" echo -e "${GREEN}║${NC} ${GREEN}║${NC}" echo -e "${GREEN}║${NC} 
