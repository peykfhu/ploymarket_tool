"$INSTALL_DIR/.env" 2>/dev/null | cut -d= -f2) B_PORT=$(grep -E "^BACKEND_PORT=" "$INSTALL_DIR/.env" 2>/dev/null | cut -d= 
-f2) F_PORT=${F_PORT:-3999} B_PORT=${B_PORT:-8899} echo "" echo "" echo -e 
